{
  "name": "focus-garden-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Focus Garden for the web. Domain logic ported from the Godot app and pinned to it by fixtures.",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply focus-garden --local",
    "db:migrate": "wrangler d1 migrations apply focus-garden --remote",
    "server:dev": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "smoke": "node --no-warnings tools/smoke-production.mjs",
    "backup": "node --no-warnings tools/backup-d1.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260829.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "chrome-launcher": "^1.2.1",
    "drizzle-kit": "^0.31.10",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "lighthouse": "^13.4.1",
    "typescript": "^5.7.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  },
  "dependencies": {
    "better-auth": "^1.7.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
