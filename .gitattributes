# Normalize line endings so Windows/Linux/macOS contributors get clean diffs.
* text=auto eol=lf

# Godot text resources must stay text so they diff and merge.
*.gd      text eol=lf
*.tres    text eol=lf
*.tscn    text eol=lf
*.godot   text eol=lf
*.cfg     text eol=lf
*.json    text eol=lf
*.svg     text eol=lf
*.md      text eol=lf

# PowerShell helper scripts need CRLF on Windows.
*.ps1     text eol=crlf

# Binary assets — never diff, never munge.
*.png     binary
*.jpg     binary
*.webp    binary
*.ogg     binary
*.wav     binary
*.ttf     binary
*.otf     binary
*.exe     binary
*.ico     binary
*.rgba    binary
*.AppImage binary
*.zip     binary
