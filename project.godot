; Focus Garden — Godot project configuration.
; Engine: Godot 4.7.1 stable (pinned portable build in tools/godot/).

config_version=5

[application]

config/name="Focus Garden"
config/description="A cozy garden grown from the time you invest in yourself."
config/version="0.1.0"
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
; A productivity app has no reason to render faster than the display. Uncapped,
; Godot renders as fast as it can and burns a core doing it (§44).
run/max_fps=60
config/icon="res://assets/ui/app_icon.svg"
boot_splash/show_image=false

[autoload]

GameLog="*res://autoload/game_log.gd"
EventBus="*res://autoload/event_bus.gd"
ContentDB="*res://autoload/content_db.gd"
SaveManager="*res://autoload/save_manager.gd"
AppState="*res://autoload/app_state.gd"
TimerManager="*res://autoload/timer_manager.gd"
ProgressionManager="*res://autoload/progression_manager.gd"
AchievementManager="*res://autoload/achievement_manager.gd"
StatisticsManager="*res://autoload/statistics_manager.gd"
AudioManager="*res://autoload/audio_manager.gd"
UpdateManager="*res://autoload/update_manager.gd"

[display]

; 1920x1080 design resolution (§5), scaled down cleanly to the 1280x720 minimum.
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/size/resizable=true
; canvas_items + expand keeps the UI crisp at any DPI and lets wider aspect
; ratios reveal more space rather than letterboxing (§5).
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom="res://ui/theme/focus_garden_light.tres"
theme/default_font_antialiasing=1

[input]

toggle_fullscreen={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":4194342,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
ui_back={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":4194305,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}

[rendering]

; gl_compatibility, not forward_plus. Focus Garden is entirely 2D Control nodes
; and custom _draw calls — it uses no 3D, no lights, no shadows, no global
; illumination. Forward+ allocates its clustered-renderer buffers regardless,
; which measured at ~800 MB and 80% of a core at idle. §44 requires reasonable
; memory and minimal idle CPU for an app that sits open for hours, and this
; single setting is the difference.
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_2d=1
textures/vram_compression/import_etc2_astc=false

; Audio buses are created at runtime by AudioManager rather than shipped as a
; .tres bus layout, so the routing stays reviewable in code. See autoload/audio_manager.gd.
